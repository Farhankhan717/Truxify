{
  "name": "truxify-backend-api",
  "version": "1.0.0",
  "description": "Truxify Backend API - Node.js, Express, WebSockets",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "check-env": "node scripts/check-env.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:load:api": "k6 run tests/load/scenarios.js",
    "test:load:ws": "k6 run tests/load/websocket.js",
    "lint": "eslint . --max-warnings=0",
    "verify-db": "node scripts/verify-db-schema.js",
    "seed:dev": "node scripts/seed-dev-profile.js",
    "benchmark:postgis": "node scripts/benchmark-postgis.js",
    "benchmark:loads": "node scripts/benchmark-load-marketplace.js"
  },
"dependencies": {
  "@opentelemetry/exporter-trace-otlp-grpc": "^1.20.0",
  "@opentelemetry/instrumentation-express": "^0.43.0",
  "@opentelemetry/instrumentation-http": "^0.47.0",
  "@opentelemetry/instrumentation-mongodb": "^0.43.0",
  "@opentelemetry/instrumentation-pino": "^0.39.0",
  "@opentelemetry/instrumentation-redis": "^0.35.0",
  "@opentelemetry/instrumentation-winston": "^0.37.0",
  "@opentelemetry/resources": "^1.20.0",
  "@opentelemetry/sdk-trace-base": "^1.20.0",
  "@opentelemetry/sdk-trace-node": "^1.20.0",
  "@opentelemetry/semantic-conventions": "^1.20.0"

  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.29.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "express",
    "websockets",
    "supabase",
    "mongodb",
    "redis",
    "firebase",
    "oracle",
    "blockchain",
    "verification"
  ],
  "author": "Truxify Dev Team",
  "license": "ISC"
}
